[Unit]
Description=Generate daily stock redistribution recommendations
After=network-online.target noc-db-tunnel.service noc-ingest-stock-status.service
Wants=network-online.target
Requires=noc-db-tunnel.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/noc-adherence/server
EnvironmentFile=/home/ubuntu/apps/noc-adherence/server/.env
ExecStart=/usr/bin/node /home/ubuntu/apps/noc-adherence/server/scripts/generateStockRedistribution.js
