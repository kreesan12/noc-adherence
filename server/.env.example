NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://154-65-108-106.sslip.io
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/noc_adherence
JWT_SECRET=replace-with-a-long-random-secret

# Gmail automation
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me
REFRESH_TOKEN=replace-me
GMAIL_STOCK_SENDER=
GMAIL_STOCK_SUBJECT=Stock Status Valuation was executed at
GMAIL_STOCK_LOOKBACK_DAYS=7

# Zendesk / ticket watchers
ZENDESK_SUBDOMAIN=replace-me
ZENDESK_EMAIL=replace-me
ZENDESK_API_TOKEN=replace-me

# WhatsApp / automation
ENABLE_WEB_WHATSAPP=0
WHATSAPP_SESSION_ID=noc-automation-01
WHATSAPP_GROUP_ID=
WHATSAPP_NLD_GROUP_ID=
WHATSAPP_VIP_GROUP_ID=
WHATSAPP_BACKHAUL_GROUP_ID=
DEFAULT_WHATSAPP_MSG=

# Prisma / pool tuning
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=20

# Optional watcher thresholds
NLD_BREACH_THRESHOLDS_HOURS=4,8,12,24
NLD_RESOLVED_LOOKBACK_HOURS=24
BACKHAUL_TAG=iris_backhaul_down
BACKHAUL_BREACH_THRESHOLDS_HOURS=4,8,12,24
BACKHAUL_LOOKBACK_HOURS=4
BACKHAUL_RESOLVED_LOOKBACK_HOURS=24

# Native NOC monitoring snapshot
NOC_MONITORING_SNAPSHOT_TTL_MS=900000
NOC_MONITORING_HARD_STALE_MS=21600000
NOC_MONITORING_HISTORY_BUCKET_MINUTES=15
NOC_MONITORING_HISTORY_WINDOW_HOURS=72
NOC_MONITORING_HISTORY_RETENTION_DAYS=45
NOC_MONITORING_INITIAL_FORM_NAME=Frogfoot Initial Form
NOC_MONITORING_T1_GROUP=NOC Tier1 Support
NOC_MONITORING_T2_GROUP=NOC Tier2 Support
NOC_MONITORING_T1_VOICE_QUEUE=NOCTier1_Queue
NOC_MONITORING_T1_P1_SLA_MINUTES=30
NOC_MONITORING_T1_VOICE_SLA_SECONDS=20
NOC_MONITORING_T1_CHANGE_CONTROL_TAG=noc_change_checks
GOOGLE_MAPS_API_KEY=

# Optional telephony snapshot feed for the NOC monitoring page
ILLATION_DASHBOARD_STATS_URL=
ILLATION_DASHBOARD_AUTH_HEADER=
ILLATION_DASHBOARD_BEARER_TOKEN=
ILLATION_DASHBOARD_API_KEY=
ILLATION_DASHBOARD_ALLOW_ANON=0
