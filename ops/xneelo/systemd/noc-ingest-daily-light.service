[Unit]
Description=NOC ingest mapped daily ADVA light levels from IRIS API
After=network-online.target noc-db-tunnel.service
Wants=network-online.target
Requires=noc-db-tunnel.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/noc-adherence/server
EnvironmentFile=/home/ubuntu/apps/noc-adherence/server/.env
ExecStart=/usr/bin/node /home/ubuntu/apps/noc-adherence/server/scripts/ingestDailyLightFromIris.js
