NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://154-65-108-106.sslip.io
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/noc_adherence
JWT_SECRET=replace-with-a-long-random-secret

# Gmail automation
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me
REFRESH_TOKEN=replace-me
GMAIL_STOCK_SENDER=
GMAIL_STOCK_SUBJECT=Stock Status Valuation was executed at
GMAIL_STOCK_LOOKBACK_DAYS=7

# Zendesk / ticket watchers
ZENDESK_SUBDOMAIN=replace-me
ZENDESK_EMAIL=replace-me
ZENDESK_API_TOKEN=replace-me

# WhatsApp / automation
ENABLE_WEB_WHATSAPP=0
WHATSAPP_SESSION_ID=noc-automation-01
WHATSAPP_GROUP_ID=
WHATSAPP_VIP_GROUP_ID=
DEFAULT_WHATSAPP_MSG=

# Prisma / pool tuning
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=20

# Optional watcher thresholds
SLA_WARNING_MINUTES=10
SLA_ACK_MINUTES=15
